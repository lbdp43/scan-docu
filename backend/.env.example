DATABASE_URL=postgresql://user:password@host:5432/railway

# REQUIRED — application will not start without these
JWT_SECRET=your-64-char-secret-here
JWT_REFRESH_SECRET=your-64-char-refresh-secret-here

# Optional — if not set, a random password will be generated and logged at first startup
DEFAULT_ADMIN_PASSWORD=change-me-immediately

# Google Drive OAuth2 (compte Google personnel)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token-from-setup-route
GOOGLE_REDIRECT_URI=https://your-backend.railway.app/api/drive/callback

# ID du dossier Google Drive (visible dans l'URL du dossier)
DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Secret temporaire pour obtenir le refresh token (supprimer après usage)
DRIVE_SETUP_SECRET=un-mot-de-passe-temporaire

# URL de base du backend (pour le callback OAuth2)
BACKEND_URL=https://your-backend.railway.app

PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TESSERACT_LANG=fra+eng

# Pennylane (rapprochement) — token aussi configurable dans l'UI (onglet Pennylane)
PENNYLANE_API_TOKEN=

# --- Notifications push (Web Push / VAPID) ---
# Générer une paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:labrasseriedesplantes@gmail.com

# --- Cron quotidien (rapprochement + push) déclenché par GitHub Actions ---
# Secret partagé : GitHub Actions envoie l'en-tête x-cron-secret avec cette valeur
CRON_SECRET=
