DATABASE_URL=postgresql://user:password@host:5432/railway
JWT_SECRET=your-64-char-secret-here
JWT_REFRESH_SECRET=your-64-char-refresh-secret-here
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
DRIVE_ROOT_FOLDER_ID=your-drive-folder-id
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TESSERACT_LANG=fra+eng

# --- Pennylane (rapprochement bancaire, lecture seule) ---
# Token API Pennylane (Paramètres > Connectivité > Développeurs).
# Un scope lecture seule suffit (transactions:readonly, bank_accounts:readonly).
PENNYLANE_TOKEN=
# Optionnels (valeurs par défaut adaptées à La Brasserie des Plantes) :
PENNYLANE_API_URL=https://app.pennylane.com/api/external/v2
# id du compte bancaire "Compte Pro Pennylane" qui porte les cartes
PENNYLANE_PRO_BANK_ACCOUNT_ID=949694
